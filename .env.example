# FormSubmit (https://formsubmit.co): submissions go to this address.
# First real submission triggers a one-time activation email from FormSubmit; click the link in that email to confirm.
NEXT_PUBLIC_FORMSUBMIT_EMAIL=

# Your public site URL, no trailing slash. Used for Open Graph metadata and the FormSubmit thank-you redirect.
# Local: http://localhost:3000
# Vercel: https://your-project.vercel.app or your custom domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000
